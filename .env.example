NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=change-me
MAX_UPLOAD_MB=20
OFFICE_NAME=Socium Contábil
CREDENTIALS_ENCRYPTION_KEY=gere-um-segredo-aleatorio-com-64-caracteres
APP_URL=https://socium.seudominio.com
# Autenticação do navegador por certificado ICP-Brasil (gateway mTLS dedicado):
CERT_AUTH_URL=https://cert.socium.seudominio.com/api/auth/certificate/callback
CERT_GATEWAY_SHARED_SECRET=gere-outro-segredo-aleatorio-com-64-caracteres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser idêntica à URI cadastrada no Google Cloud Console:
GOOGLE_REDIRECT_URI=https://socium.seudominio.com/api/integrations/gmail/callback
# Opcional após o primeiro escritório existir:
# SUPABASE_OFFICE_ID=00000000-0000-0000-0000-000000000000
# Para aplicar migrations via CLI/psql (somente no servidor; nunca NEXT_PUBLIC_):
# DATABASE_URL=postgresql://postgres.TENANT:SENHA@HOST:5432/postgres

# NFS-e: somente `simulated` local ou `government_homologation` no worker privado.
# Produção exige `government_production`, ambiente 1 e confirmação explícita.
NFSE_PROVIDER=government_homologation
NFSE_ENVIRONMENT=2
# NFSE_ENABLE_PRODUCTION=false
NFSE_DATABASE_URL=postgresql://usuario-restrito:SENHA@HOST:5432/postgres
# Em redes isoladas, o worker usa RPC HTTPS e não precisa de NFSE_DATABASE_URL.
# NFSE_WORKER_BACKEND=supabase_rpc
SUPABASE_URL=https://SEU-PROJETO.supabase.co
NFSE_CUSTODY_KEY_V1=BASE64_DE_32_BYTES_GERADA_FORA_DO_REPOSITORIO
NFSE_DPS_XSD=/app/xsd/DPS_v1.01.xsd
NFSE_FISCAL_UTC_OFFSET=-03:00

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/tls/server/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/server/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Updated exclusively from the official ITI repository.
    ssl_client_certificate /etc/nginx/tls/icp-brasil/ca-bundle.pem;
    ssl_crl /etc/nginx/tls/icp-brasil/crl-bundle.pem;
    ssl_verify_client on;
    ssl_verify_depth 10;

    location = /api/auth/certificate/callback {
        proxy_pass ${APP_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Certificate-Gateway-Secret "${CERT_GATEWAY_SHARED_SECRET}";
        proxy_set_header X-Client-Cert-Verify $ssl_client_verify;
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Client-Cert-Subject $ssl_client_s_dn;
        proxy_set_header X-Client-Cert-Issuer $ssl_client_i_dn;
        proxy_set_header X-Client-Cert-Serial $ssl_client_serial;
    }

    location / { return 404; }
}

server {
    listen 8080;
    location = /health { access_log off; return 200 'ok'; }
    location / { return 404; }
}
